APP_NAME=FinSight AI
APP_ENV=development
DEBUG=true

# Host-side URL (venv workflow). docker-compose overrides this with service names.
DATABASE_URL=postgresql+psycopg://postgres:qwe123r456@localhost:5432/finsight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=qwe123r456
POSTGRES_DB=finsight

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM (optional). Provider: openai (any OpenAI-compatible API) | anthropic | empty.
# Empty = assistant falls back to the deterministic rule-based router.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=qwen2.5:1.5b
LLM_BASE_URL=http://localhost:11434/v1

# Embeddings (optional). Provider: openai | empty (local hashing embedder).
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=384

CORS_ORIGINS=http://localhost:5173,http://localhost

MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
